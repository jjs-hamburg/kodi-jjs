diff --git a/xbmc/filesystem/NFSFile.cpp b/xbmc/filesystem/NFSFile.cpp
--- a/xbmc/filesystem/NFSFile.cpp
+++ b/xbmc/filesystem/NFSFile.cpp
@@ -819,10 +819,16 @@ ssize_t CNFSFile::Write(const void* lpBuf, size_t uiBufSize)
 {
   size_t numberOfBytesWritten = 0;
   int writtenBytes = 0;
   size_t leftBytes = uiBufSize;
 
+  CLog::Log(LOGINFO,
+            "[JJS NFS LOCK DIAG] WRITE LOCK_WAIT file={} bytes={} ctx={} fh={}",
+            m_url.GetFileName(), uiBufSize, static_cast<const void*>(m_pNfsContext),
+            static_cast<const void*>(m_pFileHandle));
   std::unique_lock<CCriticalSection> lock(gNfsConnection);
+  CLog::Log(LOGINFO,
+            "[JJS NFS LOCK DIAG] WRITE LOCK_ACQUIRED file={} bytes={} ctx={} fh={}",
+            m_url.GetFileName(), uiBufSize, static_cast<const void*>(m_pNfsContext),
+            static_cast<const void*>(m_pFileHandle));
 
   if (m_pFileHandle == NULL || m_pNfsContext == NULL)
     return -1;
@@ -852,12 +858,18 @@ ssize_t CNFSFile::Write(const void* lpBuf, size_t uiBufSize)
     {
       chunkSize = leftBytes;//write last chunk with correct size
     }
+    CLog::Log(LOGINFO,
+              "[JJS NFS LOCK DIAG] WRITE LIBNFS_ENTER file={} chunk={} left={} ctx={} fh={}",
+              m_url.GetFileName(), chunkSize, leftBytes, static_cast<const void*>(m_pNfsContext),
+              static_cast<const void*>(m_pFileHandle));
 #ifdef LIBNFS_API_V2
     writtenBytes = nfs_write(m_pNfsContext, m_pFileHandle,
                              static_cast<const char*>(lpBuf) + numberOfBytesWritten, chunkSize);
 #else
     //write chunk
     //! @bug libnfs < 2.0.0 isn't const correct
     writtenBytes = nfs_write(m_pNfsContext,
                                   m_pFileHandle,
                                   chunkSize,
                                   const_cast<char*>((const char *)lpBuf) + numberOfBytesWritten);
 #endif
+    CLog::Log(LOGINFO,
+              "[JJS NFS LOCK DIAG] WRITE LIBNFS_EXIT file={} result={} left={} ctx={} fh={}",
+              m_url.GetFileName(), writtenBytes, leftBytes, static_cast<const void*>(m_pNfsContext),
+              static_cast<const void*>(m_pFileHandle));
 
     //danger - something went wrong or no forward progress was made
     if (writtenBytes <= 0)
     {
@@ -901,6 +913,10 @@ ssize_t CNFSFile::Write(const void* lpBuf, size_t uiBufSize)
     leftBytes -= writtenBytes;
     //increase overall written bytes
     numberOfBytesWritten += writtenBytes;
   }
+  CLog::Log(LOGINFO,
+            "[JJS NFS LOCK DIAG] WRITE COMPLETE file={} requested={} written={} ctx={} fh={}",
+            m_url.GetFileName(), uiBufSize, numberOfBytesWritten,
+            static_cast<const void*>(m_pNfsContext), static_cast<const void*>(m_pFileHandle));
   //return total number of written bytes
   return numberOfBytesWritten;
 }
diff --git a/xbmc/filesystem/NFSDirectory.cpp b/xbmc/filesystem/NFSDirectory.cpp
--- a/xbmc/filesystem/NFSDirectory.cpp
+++ b/xbmc/filesystem/NFSDirectory.cpp
@@ -300,5 +300,9 @@ bool CNFSDirectory::GetDirectory(const CURL& url, CFileItemList &items)
   }
 
+  CLog::Log(LOGINFO, "[JJS NFS LOCK DIAG] DIRECTORY CLOSE_LOCK_WAIT url={}", url.Get());
   lock.lock();
+  CLog::Log(LOGINFO, "[JJS NFS LOCK DIAG] DIRECTORY CLOSE_LOCK_ACQUIRED url={}", url.Get());
+  CLog::Log(LOGINFO, "[JJS NFS LOCK DIAG] DIRECTORY CLOSEDIR_ENTER url={}", url.Get());
   nfs_closedir(gNfsConnection.GetNfsContext(), nfsdir);//close the dir
+  CLog::Log(LOGINFO, "[JJS NFS LOCK DIAG] DIRECTORY CLOSEDIR_EXIT url={}", url.Get());
   lock.unlock();
